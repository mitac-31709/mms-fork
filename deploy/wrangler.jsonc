{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mms-fork",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",

  // 静的資産は build.sh が fork/ から public/ に揃える。
  // ドキュメントとテストは公開しない。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 画面側はクライアント側でルーティングするので、資産に無いパスは index.html を返す。
    "not_found_handling": "single-page-application",
    // API だけは必ず Worker に通す。資産が先に配られると
    // `/api/*` が SPA フォールバックで index.html になってしまう。
    "run_worker_first": ["/api/*"]
  },

  "kv_namespaces": [
    {
      "binding": "NOTIFY_SUBS",
      "id": "040feacb2a524a9d89eae06232e51333",
      "preview_id": "d9d7a7788b56438592fb88056e451fa9"
    }
  ],

  // タブを閉じても Discord へ送る。1 時間ごとに購読を見る（即時性は不要）。
  "triggers": {
    "crons": ["0 * * * *"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }

  // 秘密は wrangler secret put で入れる。config には書かない。
  //   SESSION_SECRET   セッション Cookie の暗号鍵（購読レコードの封印にも使う）
  //   DISCORD_WEBHOOK  パース異常の運用通知先（任意。利用者の届け先とは別）
  // 元アプリの資格情報は Worker に持たない。利用者が自分でログインする。
  // Discord Webhook はバックグラウンド配信用に KV へ封印して置く（オフで削除）。
}
